---
import ProjectsPage from '../../../components/projects/ProjectsPage.astro';
import { LOCALES, useTranslations, type Locale } from '../../../lib/i18n';
import { ALL } from '../../../lib/projects';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---

<ProjectsPage locale={locale} active={ALL} title={t('section.projects')} />
