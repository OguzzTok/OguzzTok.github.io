---
/** Ana sayfa: hero + sayaçlar, ardından bölümler (sıra: src/lib/sections.ts). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsExplorer from '../../components/projects/ProjectsExplorer.astro';
import About from '../../components/sections/About.astro';
import Certificates from '../../components/sections/Certificates.astro';
import Contact from '../../components/sections/Contact.astro';
import Downloads from '../../components/sections/Downloads.astro';
import Hero from '../../components/sections/Hero.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { LOCALES, useTranslations, type Locale } from '../../lib/i18n';
import { SECTIONS, type SectionId } from '../../lib/sections';
import { personJsonLd } from '../../lib/seo';
import { printTranslationReport } from '../../lib/translation-report';

export async function getStaticPaths() {
  await printTranslationReport();
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const components: Record<SectionId, (props: { locale: Locale }) => unknown> = {
  projects: ProjectsExplorer,
  about: About,
  certificates: Certificates,
  downloads: Downloads,
  contact: Contact,
};
---

<BaseLayout locale={locale}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(await personJsonLd(locale)).replaceAll('<', '\\u003c')} />
  <Hero locale={locale} />

  {
    SECTIONS.map((section) => {
      const Section = components[section.id];
      return (
        // Boşluk margin ile: #bölüm linki başlığın hemen üstüne kaydırır (header payı: html scroll-padding-top)
        <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6 md:mt-32" aria-labelledby={`${section.id}-title`} id={section.id}>
          <SectionHeading title={t(section.title)} id={`${section.id}-title`} />
          <Section locale={locale} />
        </section>
      );
    })
  }
</BaseLayout>
