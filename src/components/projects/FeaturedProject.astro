---
/** Sekmelerin üstündeki büyük "öne çıkan proje" kartı. */
import { Image } from 'astro:assets';
import LocalizedText from '../ui/LocalizedText.astro';
import StatusBadge from './StatusBadge.astro';
import { l, useTranslations, type Locale } from '../../lib/i18n';
import { projectHref, type Category, type Project } from '../../lib/projects';

interface Props {
  project: Project;
  category: Category;
  locale: Locale;
  fullImage?: string;
  headingLevel?: 2 | 3;
  /** Sayfanın en üstündeyse görsel hemen yüklensin */
  eager?: boolean;
}

const { project, category, locale, fullImage, headingLevel = 3, eager = false } = Astro.props;
const t = useTranslations(locale);
const { data } = project;
const isDetail = category.data.mode === 'detail';
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = isDetail ? projectHref(project, category, locale) : (fullImage ?? projectHref(project, category, locale));
---

<article class="group relative mb-16 grid gap-6 md:mb-20 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] md:items-center md:gap-10" data-featured>
  <div class="relative aspect-video overflow-hidden rounded-sm bg-surface-2 shadow-card">
    <Image
      src={data.cover.src}
      alt={l(data.cover.alt, locale)}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1152px) 660px, (min-width: 768px) 60vw, 100vw"
      class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <StatusBadge status={data.status} locale={locale} class="absolute top-4 left-4" />
  </div>

  <div>
    <p class="eyebrow text-accent-text">
      {t('projects.featured')} · {l(category.data.name, locale)} · {data.date.getUTCFullYear()}
    </p>
    <Heading class="mt-3 text-4xl font-medium md:text-5xl">
      <LocalizedText value={data.title} locale={locale} />
    </Heading>
    <LocalizedText value={data.summary} locale={locale} as="p" class="mt-4 text-lg text-muted" />
    {
      data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }
    <a href={href} class="btn btn-primary mt-7" data-lightbox-open={isDetail ? undefined : project.id}>
      {isDetail ? t('projects.cta.detail') : t('projects.cta.lightbox')}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
