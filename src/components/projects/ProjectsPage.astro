---
/** /projects/ ve /projects/<kategori>/ sayfalarının ortak gövdesi. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsExplorer from './ProjectsExplorer.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  active: string;
  /** Sayfa başlığı (kategori adı veya "Projeler") */
  title: string;
}

const { locale, active, title } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={title} description={t('projects.page.description')}>
  <div class="mx-auto max-w-6xl px-4 pt-14 pb-10 sm:px-6 md:pt-20">
    <!-- Sekme değişince sayfa yenilenmediği için başlık sabit; aktif kategori sekmede görünür. -->
    <p class="eyebrow">{t('projects.page.description')}</p>
    <h1 class="mt-3 mb-12 text-5xl font-medium md:text-7xl">{t('section.projects')}</h1>
    <ProjectsExplorer locale={locale} active={active} urlMode="push" headingLevel={2} eagerFeatured />
  </div>
</BaseLayout>
