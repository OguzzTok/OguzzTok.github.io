---
import { LOCALES, otherLocale, useTranslations, type Locale } from '../../lib/i18n';
import { alternatePath } from '../../lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
const href = alternatePath(Astro.url.pathname, target);
---

<!--
  Tek düğme: EN ↔ TR. Aynı sayfanın diğer dildeki adresine gider, seçimi hatırlar.
  Erişilebilir ad görünen "EN TR" yazısını içerir (sesli komutla "TR"ye tıklanabilsin) + gizli açıklama.
-->
<a
  href={href}
  hreflang={target}
  data-lang-switch={target}
  title={t('lang.switch.label')}
  class="flex h-10 items-center gap-1 px-2.5 font-display text-sm hover:bg-surface-2"
>
  {
    LOCALES.map((code, i) => (
      <>
        {i > 0 && <span class="text-line" aria-hidden="true">/</span>}
        <span class={code === locale ? 'font-semibold text-fg' : 'text-muted'}>{code.toUpperCase()}</span>
      </>
    ))
  }
  <span class="sr-only" lang={target}>{t('lang.switch.label')}</span>
</a>

<script>
  import { initLangSwitch } from '../../scripts/lang';
  initLangSwitch();
</script>
