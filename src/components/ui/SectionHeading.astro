---
/** Bölüm başlığı: küçük pixel blok + başlık. */
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<div class="mb-10 flex items-center gap-4 md:mb-14">
  <span class="px-marker text-4xl md:text-6xl" aria-hidden="true"></span>
  <h2 id={id} class="text-4xl md:text-6xl">{title}</h2>
</div>
