---
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
  class="grid size-10 place-items-center text-muted hover:bg-surface-2 hover:text-fg"
>
  <!-- Gecede güneş (gündüze geç), gündüzde ay (geceye geç). 12×12 pixel ikonlar. -->
  <svg class="theme-icon-sun size-6" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
    <path d="M4 3h4v1h1v4H8v1H4V8H3V4h1zM5 0h2v2H5zM5 10h2v2H5zM0 5h2v2H0zM10 5h2v2h-2zM1 1h2v2H1zM9 1h2v2H9zM1 9h2v2H1zM9 9h2v2H9z"></path>
  </svg>
  <svg class="theme-icon-moon size-6" viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
    <path d="M4 1h4v1H6v1H5v6h1v1h3v1H4v-1H3V9H2V3h1V2h1z"></path>
  </svg>
</button>

<style>
  .theme-icon-moon {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-moon {
    display: block;
  }
  :global([data-theme='light']) .theme-icon-sun {
    display: none;
  }
</style>

<script>
  import { initThemeToggle } from '../../scripts/theme';
  initThemeToggle();
</script>
