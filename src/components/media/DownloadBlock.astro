---
/** İndirilebilir dosya: ad, tür ve boyut build sırasında dosyadan okunur. */
import { formatBytes, type PublishedFile } from '../../lib/assets';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  file: PublishedFile;
  label?: string;
  locale: Locale;
}

const { file, label, locale } = Astro.props;
const t = useTranslations(locale);
const extension = file.name.split('.').pop()?.toUpperCase();
---

<a
  href={file.url}
  download={file.name}
  class="group my-12 flex items-center gap-4 rounded-sm border border-line bg-surface p-4 transition-colors hover:border-fg"
>
  <span class="grid size-12 shrink-0 place-items-center rounded-sm bg-surface-2 font-mono text-xs text-accent-text">{extension}</span>
  <span class="min-w-0 flex-1">
    <span class="block font-semibold">{label ?? file.name}</span>
    <span class="block truncate font-mono text-xs text-muted">{file.name} · {formatBytes(file.bytes)}</span>
  </span>
  <span class="btn btn-ghost shrink-0 py-1.5 text-xs group-hover:border-fg">↓ {t('media.download')}</span>
</a>
