---
/**
 * Tıklayınca yüklenen YouTube videosu. Öncesinde YouTube'a hiçbir istek gitmez
 * (kapak varsa kapak, yoksa düz zemin). JS kapalıysa YouTube'da açılır.
 */
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../../lib/i18n';
import { youtubeId } from '../../lib/projects';

interface Props {
  video: string; // id veya link
  title: string;
  locale: Locale;
  cover?: { src: ImageMetadata; alt: string };
  id?: string;
  eager?: boolean;
}

const { video, title, locale, cover, id, eager = false } = Astro.props;
const t = useTranslations(locale);
const videoId = youtubeId(video);
---

<div
  id={id}
  class="px-frame group relative aspect-video overflow-hidden bg-surface-2"
  data-embed
  data-embed-src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`}
  data-embed-title={title}
  data-embed-allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
>
  {
    cover && (
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[768, 1152, 1536, 2304]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        class="size-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    )
  }
  <a
    href={`https://www.youtube.com/watch?v=${videoId}`}
    target="_blank"
    rel="noopener"
    class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center"
    data-embed-trigger
  >
    <span class="px-frame-drop grid size-20 place-items-center bg-accent text-accent-on [--frame-color:var(--drop)] group-hover:-translate-x-[3px] group-hover:-translate-y-[3px]">
      <svg viewBox="0 0 24 24" class="ml-1 size-8" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
    </span>
    <span class="bg-bg/85 px-3 py-1 font-display text-base font-semibold">{t('media.play')}<span class="sr-only">: {title}</span></span>
  </a>
  <p class="pointer-events-none absolute right-3 bottom-3 bg-bg/85 px-2 py-1 text-xs text-muted">
    {t('media.youtubeNote')}
  </p>
</div>
