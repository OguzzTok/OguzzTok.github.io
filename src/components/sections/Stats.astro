---
/**
 * Sayaçlar (src/data/stats.yaml): hero sahnesinin zemininde durur. HTML'de son değer yazılıdır; JS ekrana girince 0'dan sayar.
 * Ekran okuyucu animasyonlu sayıyı değil, gizli metindeki son değeri okur.
 */
import { formatNumber, useTranslations, type Locale } from '../../lib/i18n';
import { getStats } from '../../lib/stats';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const stats = await getStats(locale);
---

{
  stats.length > 0 && (
    <div class="bg-surface-2">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-6 px-4 pt-2 pb-10 sm:px-6 md:grid-cols-4" aria-label={t('stats.label')}>
        {stats.map((stat) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="font-display text-base text-muted">{stat.label}</dt>
            <dd class="font-display text-5xl font-bold text-accent-text md:text-6xl" data-stat={stat.id}>
              <span aria-hidden="true">
                <span data-counter={stat.value}>{formatNumber(stat.value, locale)}</span>
                {stat.suffix && <span>{stat.suffix}</span>}
              </span>
              <span class="sr-only">
                {formatNumber(stat.value, locale)}
                {stat.suffix}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<script>
  import { initCounters } from '../../scripts/counters';
  initCounters();
</script>
