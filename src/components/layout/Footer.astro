---
import { getSite } from '../../lib/content';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="px-ground mt-24">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-muted sm:px-6">
    <p class="font-display">© {year} {site.name} · {t('footer.built')}</p>
    <a href="#main" class="font-display hover:text-fg">{t('footer.top')} ↑</a>
  </div>
</footer>
